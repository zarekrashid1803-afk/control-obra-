# ============================================================
# CONTROL DE OBRA — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ============================================================

NODE_ENV=development

# ---------- API ----------
API_PORT=3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ---------- Base de datos ----------
# Opción A (recomendada local): Docker Compose (npm run db:up)
DATABASE_URL=postgresql://control_obra:control_obra_dev@localhost:5432/control_obra?schema=public

# Opción B: Neon Cloud (sin Docker) — sign up en neon.tech y pega aquí
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/control_obra?sslmode=require

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# ---------- JWT ----------
JWT_SECRET=replace-this-in-prod-with-a-256bit-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Logging ----------
LOG_LEVEL=debug
LOG_PRETTY=true

# ---------- Tenancy ----------
DEFAULT_TENANT_ID=1

# ---------- Reglas de negocio ----------
IVA_RATE=0.19
RETEFUENTE_DEFAULT=0.025
RETEIVA_DEFAULT=0.15
RETEICA_DEFAULT=0.00966
UMBRAL_APROBACION_DIRECTOR_CENTAVOS=1000000000

# ---------- Almacenamiento (opcional, S3) ----------
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=control-obra-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
